# Required by the current application's OpenAI LLM and embeddings
OPENAI_API_KEY=your-openai-api-key

# Required by corrective web-search fallback
TAVILY_API_KEY=your-tavily-api-key

# Optional local Chroma settings; no Chroma API key or hosted URL is required
CHROMA_PERSIST_DIRECTORY=.chroma_db
CHROMA_COLLECTION_NAME=documents_chroma

# Optional model settings (defaults are configured in src/config/config.py)
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
JUDGE_MODEL=gpt-5.6-luna

# Optional LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-document-intelligence
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
